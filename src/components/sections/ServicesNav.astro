---
import LineartField from '../ui/LineartField.astro';
import type { Service } from '../../types';

interface Props {
  services: Service[];
  currentSlug: string;
}

const { services, currentSlug } = Astro.props;
const total = String(services.length).padStart(2, '0');
---

<section class="py-24 border-t border-border relative overflow-hidden">
  <LineartField />
  <div class="container relative z-10">
    <div class="services-nav__head" data-reveal="up">
      <h2 class="text-3xl md:text-5xl font-bold">All Services</h2>
      <span class="services-nav__count">{total} services</span>
    </div>

    <div class="services-nav">
      {services.map((item, index) => {
        const num = String(index + 1).padStart(2, '0');
        return item.slug === currentSlug ? (
          <span class="service-row service-row--current" aria-current="page">
            <span class="service-row__content">
              <span class="service-row__num">{num}</span>
              <span class="service-row__title">{item.title}</span>
            </span>
            <span class="service-row__tag">You're here</span>
          </span>
        ) : (
          <a href={`/services/${item.slug}/`} class="service-row" data-cursor="explore">
            <span class="service-row__content">
              <span class="service-row__num">{num}</span>
              <span class="service-row__title">{item.title}</span>
            </span>
            <svg
              class="service-row__arrow"
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .services-nav__head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 3rem;
  }

  .services-nav__count {
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  @media (min-width: 768px) {
    .services-nav__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .services-nav {
    display: flex;
    flex-direction: column;
  }

  .service-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.75rem 0;
    border-top: 1px solid rgba(196, 138, 42, 0.3);
    text-decoration: none;
    color: inherit;
    transition:
      padding-left 0.3s ease,
      background-color 0.3s ease;
  }

  .service-row:last-child {
    border-bottom: 1px solid rgba(196, 138, 42, 0.3);
  }

  .service-row:hover {
    padding-left: 1rem;
    background-color: rgba(196, 138, 42, 0.05);
  }

  .service-row:hover .service-row__title {
    color: var(--color-accent);
  }

  .service-row:hover .service-row__arrow {
    color: var(--color-accent);
    transform: translate(4px, -4px);
  }

  .service-row__content {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    min-width: 0;
  }

  .service-row__num {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    color: var(--color-muted);
    flex-shrink: 0;
  }

  .service-row__title {
    font-size: clamp(1.4rem, 4vw, 2.75rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.05;
    transition: color 0.3s ease;
  }

  .service-row__arrow {
    color: var(--color-muted);
    transition:
      color 0.3s ease,
      transform 0.3s ease;
    flex-shrink: 0;
    stroke-width: 1;
  }

  .service-row--current {
    background-color: rgba(196, 138, 42, 0.05);
    cursor: default;
  }

  .service-row--current .service-row__title {
    color: var(--color-accent);
  }

  .service-row__tag {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    border: 1px solid rgba(196, 138, 42, 0.5);
    padding: 0.4rem 0.75rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .service-row,
    .service-row__title,
    .service-row__arrow {
      transition: none;
    }
  }
</style>
