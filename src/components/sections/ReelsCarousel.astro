<style>
  .reels-wrapper {
    overflow: hidden;
  }

  .reels-track {
    display: flex;
    gap: 1.5rem;
    animation: scroll-reels 25s linear infinite;
    width: max-content;
  }

  .reels-slide {
    flex-shrink: 0;
    width: 280px;
    height: 400px;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .reel-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @keyframes scroll-reels {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-280px * 3 - 1.5rem * 3));
    }
  }

  .reels-track:hover {
    animation-play-state: paused;
  }
</style>
