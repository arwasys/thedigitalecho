---
import LineartField from '../ui/LineartField.astro';
import type { IndustriesSectionData } from '../../types';

interface Props {
  data?: IndustriesSectionData;
  title1?: string;
  title2?: string;
}

const {
  data,
  title1 = 'INDUSTRIES',
  title2 = 'WE WORK WITH.',
} = Astro.props;
---

{data && data.industries.length > 0 && (
  <section class="py-24 border-b border-border relative overflow-hidden">
  <LineartField />
    <div class="container relative z-10">
      <h2 class="text-4xl md:text-6xl lg:text-8xl font-bold tracking-tight leading-none mb-8" data-text-reveal>
        <span class="reveal-line block text-accent-blue">{title1}</span>
        <span class="reveal-line block">{title2}</span>
      </h2>
      <p class="text-lg text-muted-foreground max-w-2xl mb-4" data-reveal="up">{data.heading}</p>
      <p class="text-muted-foreground max-w-2xl mb-12" data-reveal="up">{data.intro}</p>
      <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3">
        {data.industries.map((industry, index) => (
          <li
            class="border border-border px-4 py-3 text-sm sm:text-base hover:border-accent hover:text-accent transition-colors duration-300"
            data-reveal="up"
            data-delay={index * 0.03}
          >
            {industry}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
