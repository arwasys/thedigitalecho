---
import LineartField from '../ui/LineartField.astro';
import { Card, CardContent } from '@/components/ui/card';
import type { Testimonial } from '../../types';

interface Props {
  testimonials?: Testimonial[];
  title1?: string;
  title2?: string;
}

const {
  testimonials = [],
  title1 = 'WORD',
  title2 = 'OF MOUTH.',
} = Astro.props;
---

{testimonials.length > 0 && (
<section class="py-24 border-b border-border relative overflow-hidden">
  <LineartField />
  <div class="container relative z-10">
    <h2 class="text-4xl md:text-6xl lg:text-8xl font-bold tracking-tight leading-none mb-16" data-text-reveal>
      <span class="reveal-line block">{title1}</span>
      <span class="reveal-line block text-accent">{title2}</span>
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((t, index) => (
        <Card className="p-8 bg-card border-border" data-reveal="up" data-delay={index * 0.1}>
          <CardContent className="p-0">
            <p class="text-lg mb-8 leading-relaxed">"{t.quote}"</p>
            <footer class="flex items-center gap-4">
              {t.avatar ? (
                <img
                  src={t.avatar}
                  alt={t.author}
                  class="h-12 w-12 rounded-full object-cover shrink-0"
                  loading="lazy"
                />
              ) : (
                <div class="h-12 w-12 rounded-full bg-accent/20 flex items-center justify-center text-accent font-bold shrink-0">
                  {t.author.split(' ').map(n => n[0]).join('')}
                </div>
              )}
              <div>
                <p class="font-bold">{t.author}</p>
                <p class="text-sm text-muted-foreground">{t.company}{t.designation ? ` · ${t.designation}` : ''}</p>
              </div>
            </footer>
          </CardContent>
        </Card>
      ))}
    </div>
  </div>
</section>
)}
