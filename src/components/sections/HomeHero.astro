---
import VideoBackground from '../ui/VideoBackground.astro';
---

<VideoBackground>
  <div class="hero-badge inline-block mb-6 px-4 py-2 border border-text/20 text-xs tracking-widest uppercase">
    Digital Marketing & Content Studio
  </div>
  <h1 class="text-5xl md:text-7xl lg:text-9xl font-bold tracking-tight leading-[0.9] mb-8">
    <span class="hero-title-line block">YOUR BRAND.</span>
    <span class="hero-title-line block text-accent-blue">OUR CREATIVE</span>
    <span class="hero-title-line block text-accent">ECHO.</span>
  </h1>
  <p class="hero-description text-lg md:text-xl text-text/80 max-w-2xl mx-auto mb-12">
    A Gen Z-led digital marketing and content production company creating content, campaigns and digital experiences people actually remember.
  </p>
  <div class="flex flex-col sm:flex-row gap-4 justify-center">
    <a
      href="/contact/"
      class="hero-btn btn btn-gold"
      data-magnetic="0.3"
    >
      LET'S MAKE SOME NOISE →
    </a>
    <a
      href="/projects/"
      class="hero-btn btn btn-black"
      data-magnetic="0.3"
    >
      SEE THE WORK →
    </a>
  </div>
</VideoBackground>
