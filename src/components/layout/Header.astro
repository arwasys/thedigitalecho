---
import { getSiteSettings } from '../../lib/data';

const settings = await getSiteSettings();

const SLOGAN_URL = 'https://tde.arwasys.in/wp-content/uploads/2026/10/slogan_1.svg';
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500" transition:name="header" transition:animate="none">
  <div class="container header-bar flex items-center justify-between py-4 md:py-6">
    <!-- Logo + slogan -->
    <div class="flex flex-col items-start gap-1.5 relative z-10">
      <a href="/" class="flex items-center hover:opacity-80 transition-opacity duration-300">
        {settings.logo ? (
          <img 
            src={settings.logo} 
            alt={settings.title}
            class="header-logo h-16 md:h-20 w-auto"
          />
        ) : (
          <span class="text-sm font-bold tracking-widest uppercase transition-colors duration-300">
            THE <span class="text-accent">DIGITAL</span> ECHO
          </span>
        )}
      </a>
      <img
        src={SLOGAN_URL}
        alt="Let's Make Some Noise."
        width="1089"
        height="124"
        class="header-slogan h-4 md:h-5 w-auto"
      />
    </div>

    <!-- Right Side: CTA + Hamburger -->
    <div class="flex items-center gap-6 relative z-10">
      <a
        href="/contact/"
        class="btn btn-blue btn-sm hidden md:inline-flex"
        data-magnetic="0.3"
      >
        LET'S TALK →
      </a>

      <!-- Hamburger Menu Toggle -->
      <button
        id="menu-toggle"
        class="flex flex-col gap-2 p-2 group"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span class="w-8 h-0.5 bg-text transition-all duration-300 group-hover:bg-accent"></span>
        <span class="w-8 h-0.5 bg-text transition-all duration-300 group-hover:bg-accent"></span>
      </button>
    </div>
  </div>
</header>

<script>
  function handleScroll() {
    const header = document.getElementById('site-header');
    if (!header) return;
    
    if (window.scrollY > 50) {
      header.classList.add('bg-bg/90', 'backdrop-blur-md', 'border-b', 'border-border', 'is-scrolled');
    } else {
      header.classList.remove('bg-bg/90', 'backdrop-blur-md', 'border-b', 'border-border', 'is-scrolled');
    }
  }
  
  function initHeader() {
    // Re-binding instead of stacking: module eval + astro:page-load both fire
    // on the initial load, and this listener must stay a single instance.
    window.removeEventListener('scroll', handleScroll);
    handleScroll();
    window.addEventListener('scroll', handleScroll, { passive: true });
  }

  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>

<style>
  #site-header .header-bar,
  #site-header .header-logo,
  #site-header .header-slogan {
    transition:
      padding 0.4s ease,
      height 0.4s ease;
  }

  #site-header .btn-sm {
    transition:
      padding 0.4s ease,
      background-color 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease;
  }

  /* Compact bar once the page is scrolled */
  #site-header.is-scrolled .header-bar {
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }

  #site-header.is-scrolled .header-logo {
    height: 2.5rem;
  }

  #site-header.is-scrolled .header-slogan {
    height: 0.75rem;
  }

  #site-header.is-scrolled .btn-sm {
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    padding-inline: 1rem;
  }

  @media (min-width: 768px) {
    #site-header.is-scrolled .header-logo {
      height: 3rem;
    }

    #site-header.is-scrolled .header-slogan {
      height: 1rem;
    }
  }
</style>
