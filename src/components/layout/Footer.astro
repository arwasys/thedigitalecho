---
import { getSiteSettings, getMenus, getSiteData, getServices, getOffices } from '../../lib/data';
import { getContactLinks } from '../../lib/contact-links';

const [settings, menus, siteData, services, offices] = await Promise.all([
  getSiteSettings(),
  getMenus(),
  getSiteData(),
  getServices(),
  getOffices(),
]);
const { footer, contact } = siteData;
const currentYear = new Date().getFullYear();

// Fallbacks mirror the original hardcoded navigation if WordPress menus are unavailable.
const fallbackExplore = [
  { label: 'What We Do', url: '/services/' },
  { label: 'Our Work', url: '/projects/' },
  { label: 'The Crew', url: '/about/' },
  { label: 'The Drop', url: '/blog/' },
  { label: "Let's Talk", url: '/contact/' },
];

// Navigate column mirrors the primary menu (same links as the header / fullscreen nav).
const exploreLinks = menus.primary.length
  ? menus.primary.map((item) => ({ label: item.label, url: item.url }))
  : menus.footerExplore.length
    ? menus.footerExplore
    : fallbackExplore;

// Services column — every service, same routes as the /services/ list.
const serviceLinks = services.map((service) => ({
  label: service.title,
  url: `/services/${service.slug}/`,
}));

/* Footer Contact column — address/phone come from the Head Office (`office` CPT),
   email + WhatsApp + socials from the `siteContact` ACF group (with office fallback). */
const { whatsappHref, whatsappLabel, socials: contactSocials } = getContactLinks(contact);
const headOffice = offices.find((office) => /head/i.test(office.companyType)) || offices[0];
const officeAddress = headOffice?.address || contact.contactAddress || '';
const officePhones = (
  headOffice ? [headOffice.phone1, headOffice.phone2] : [contact.contactPhone]
).map((phone) => phone.trim()).filter(Boolean);
const contactEmail = contact.contactEmail || headOffice?.email || '';

const SLOGAN_URL = 'https://tde.arwasys.in/wp-content/uploads/2026/10/slogan_1.svg';
---

<footer class="border-t border-border">
  <div class="container py-16 md:py-24">
    <!-- Logo + slogan -->
    <div class="mb-12 md:mb-16">
      <a href="/" class="inline-block hover:opacity-80 transition-opacity duration-300">
        {settings.logo ? (
          <img
            src={settings.logo}
            alt={settings.title}
            class="h-16 md:h-20 w-auto"
          />
        ) : (
          <span class="text-lg font-bold tracking-widest uppercase">
            THE DIGITAL ECHO
          </span>
        )}
      </a>
      <img
        src={SLOGAN_URL}
        alt="Let's Make Some Noise."
        width="1089"
        height="124"
        class="mt-2 block h-5 md:h-6 w-auto"
      />
      {footer.footerBlurb && (
        <p class="mt-4 max-w-md text-sm text-muted-foreground">{footer.footerBlurb}</p>
      )}
    </div>

    <!-- Links Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-16 min-w-0 [overflow-wrap:anywhere]">
      <!-- Navigate -->
      <div>
        <h3 class="text-xs font-medium tracking-wider uppercase text-accent-blue mb-6">Navigate</h3>
        <nav class="flex flex-col gap-3">
          {exploreLinks.map((link) => (
            <a
              href={link.url}
              class="text-lg hover:text-accent transition-colors duration-300"
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-xs font-medium tracking-wider uppercase text-accent-blue mb-6">Services</h3>
        <nav class="flex flex-col gap-3">
          {serviceLinks.map((link) => (
            <a
              href={link.url}
              class="text-lg hover:text-accent transition-colors duration-300"
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-xs font-medium tracking-wider uppercase text-accent-blue mb-6">Contact</h3>
        <div class="flex flex-col gap-3 text-lg">
          {officeAddress && (
            <p class="whitespace-pre-line text-muted-foreground">{officeAddress}</p>
          )}
          {officePhones.map((phone) => (
            <a
              href={`tel:${phone.replace(/\s+/g, '')}`}
              class="hover:text-accent transition-colors duration-300"
            >
              {phone}
            </a>
          ))}
          {whatsappHref && (
            <a href={whatsappHref} class="hover:text-accent transition-colors duration-300" target="_blank" rel="noopener noreferrer">
              {whatsappLabel}
            </a>
          )}
          {contactEmail && (
            <a href={`mailto:${contactEmail}`} class="hover:text-accent transition-colors duration-300">
              {contactEmail}
            </a>
          )}
        </div>

        {contactSocials.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2">
            {contactSocials.map((social) => (
              <a
                href={social.url}
                class="text-sm tracking-wider uppercase text-muted-foreground hover:text-accent transition-colors duration-300"
                target="_blank"
                rel="noopener noreferrer"
              >
                {social.label}
              </a>
            ))}
          </div>
        )}
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 pt-8 border-t border-border">
      <p class="text-sm text-muted-foreground">
        {footer.footerCopyright || `© ${currentYear} ${settings.title}. All rights reserved.`}
      </p>
      <nav class="flex gap-4 text-sm text-muted-foreground">
        <a href="/privacy-policy/" class="hover:text-accent transition-colors duration-300">Privacy</a>
        <a href="/terms-and-conditions/" class="hover:text-accent transition-colors duration-300">Terms</a>
        <a href="/cookie-policy/" class="hover:text-accent transition-colors duration-300">Cookies</a>
      </nav>
      <p class="text-sm text-muted-foreground font-medium tracking-wider">
        {footer.footerTagLine || 'CREATE. CONNECT. ECHO.'}
      </p>
    </div>
  </div>
</footer>
