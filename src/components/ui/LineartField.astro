---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const images = [
  'corporate-photography.webp',
  'digitaloffice.webp',
  'drone-photography..webp',
  'photgrapher.webp',
  'product-photography.webp',
  'socialmedia.webp',
  'sport-photography.webp',
  'video-editor.webp',
  'videographer.webp',
];
---

<div class={`lineart-field ${className}`} data-lineart-field aria-hidden="true">
  {images.map((src) => (
    <img
      src={`/assets/lineart/${src}`}
      alt=""
      loading="lazy"
      decoding="async"
      class="lineart-float"
      data-lineart-float
    />
  ))}
</div>

<script>
  import { gsap } from 'gsap';

  const registry = new Set<gsap.core.Animation>();
  const rand = (min: number, max: number) => gsap.utils.random(min, max);

  const COLS = [
    [2, 28],
    [32, 48],
    [55, 66],
  ];
  const ROWS = [
    [2, 26],
    [28, 46],
    [48, 60],
  ];

  function place(img: HTMLImageElement, cell: number) {
    const col = cell % 3;
    const row = Math.floor(cell / 3);
    gsap.set(img, {
      left: `${rand(COLS[col][0], COLS[col][1])}%`,
      top: `${rand(ROWS[row][0], ROWS[row][1])}%`,
      x: 0,
      y: 0,
      xPercent: rand(-8, 8),
      yPercent: rand(-8, 8),
      rotation: rand(-18, 18),
      scale: rand(0.6, 1.3),
      transformOrigin: 'center center',
    });
  }

  function cycle(img: HTMLImageElement, cell: number) {
    place(img, cell);

    const tl = gsap.timeline({
      delay: rand(0.4, 5),
      onComplete: () => {
        registry.delete(tl);
        cycle(img, cell);
      },
    });

    registry.add(tl);

    tl.fromTo(
      img,
      { opacity: 0 },
      { opacity: rand(0.15, 0.3), duration: rand(1.6, 3.4), ease: 'sine.out' },
    )
      .to(
        img,
        {
          x: rand(-70, 70),
          y: rand(-50, 50),
          rotation: rand(-30, 30),
          duration: rand(8, 15),
          ease: 'sine.inOut',
        },
        '<',
      )
      .to(img, { opacity: 0, duration: rand(1.6, 3.4), ease: 'sine.in' })
      .to({}, { duration: rand(2, 7) });
  }

  function init() {
    document.querySelectorAll<HTMLElement>('[data-lineart-field]').forEach((field) => {
      if (field.dataset.init) return;
      field.dataset.init = '1';

      const imgs = field.querySelectorAll<HTMLImageElement>('[data-lineart-float]');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // shuffle 9 grid cells so each image owns a spawn zone (no clustering)
      const cells = gsap.utils.shuffle([0, 1, 2, 3, 4, 5, 6, 7, 8]);

      imgs.forEach((img, i) => {
        const cell = cells[i % cells.length];
        place(img, cell);
        if (reduced) {
          gsap.set(img, { opacity: rand(0.12, 0.2) });
          return;
        }
        cycle(img, cell);
      });
    });
  }

  function cleanup() {
    registry.forEach((tl) => tl.kill());
    registry.clear();
  }

  init();
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', cleanup);
</script>

<style>
  .lineart-field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .lineart-float {
    position: absolute;
    top: 0;
    left: 0;
    width: clamp(220px, 26vw, 430px);
    height: auto;
    opacity: 0;
    filter: invert(1) sepia(0.3);
    mix-blend-mode: screen;
    -webkit-mask-image: radial-gradient(closest-side, #000 45%, transparent 78%);
    mask-image: radial-gradient(closest-side, #000 45%, transparent 78%);
  }
</style>
