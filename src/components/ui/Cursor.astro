---
// Custom cursor — desktop only, hidden on touch/reduced-motion
---

<div class="cursor" aria-hidden="true" transition:persist="cursor">
  <div class="cursor__dot"></div>
  <div class="cursor__ring"></div>
  <div class="cursor__label"></div>
</div>

<style>
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9999;
    pointer-events: none;
    mix-blend-mode: difference;
    display: none;
  }

  @media (pointer: fine) and (hover: hover) {
    .cursor {
      display: block;
    }
  }

  .cursor__dot {
    width: 8px;
    height: 8px;
    background: var(--color-accent);
    border-radius: 50%;
    position: absolute;
    top: -4px;
    left: -4px;
    transition: transform 0.15s ease, background 0.3s ease;
  }

  .cursor__ring {
    width: 40px;
    height: 40px;
    border: 1.5px solid var(--color-accent);
    border-radius: 50%;
    position: absolute;
    top: -20px;
    left: -20px;
    transition: width 0.3s ease, height 0.3s ease, top 0.3s ease, left 0.3s ease,
      border-color 0.3s ease, background 0.3s ease, opacity 0.3s ease;
  }

  .cursor__label {
    position: absolute;
    top: -20px;
    left: 40px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    white-space: nowrap;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  /* States */
  .cursor.is-view .cursor__ring {
    width: 80px;
    height: 80px;
    top: -40px;
    left: -40px;
    background: rgba(196, 138, 42, 0.1);
  }

  .cursor.is-view .cursor__label {
    opacity: 1;
    transform: translateY(0);
  }

  .cursor.is-drag .cursor__dot {
    transform: scale(2);
  }

  .cursor.is-drag .cursor__ring {
    width: 60px;
    height: 60px;
    top: -30px;
    left: -30px;
    border-color: var(--color-accent-blue);
  }

  .cursor.is-open .cursor__dot {
    transform: scale(0.5);
    background: var(--color-accent-blue);
  }

  .cursor.is-open .cursor__ring {
    width: 60px;
    height: 60px;
    top: -30px;
    left: -30px;
    border-color: var(--color-accent-blue);
    background: rgba(26, 58, 138, 0.1);
  }

  .cursor.is-explore .cursor__ring {
    width: 100px;
    height: 100px;
    top: -50px;
    left: -50px;
    background: rgba(196, 138, 42, 0.05);
    border-style: dashed;
  }

  .cursor.is-hidden .cursor__dot,
  .cursor.is-hidden .cursor__ring {
    opacity: 0;
    transform: scale(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      display: none !important;
    }
  }
</style>
