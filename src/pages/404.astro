---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import LineartField from '../components/ui/LineartField.astro';
---

<BaseLayout title="404">
  <Header />
  <main transition:name="page">
    <section class="min-h-screen flex items-center justify-center pt-20 relative overflow-hidden">
      <LineartField />
      <div class="container text-center relative z-10">
        <h1 class="text-5xl md:text-7xl lg:text-9xl font-bold tracking-tight leading-none mb-8">
          404
        </h1>
        <p class="text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto mb-8">
          This page doesn't exist. Yet.
        </p>
        <a
          href="/"
          class="btn btn-gold"
        >
          GO HOME →
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
